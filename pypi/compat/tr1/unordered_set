// Compatibility header used only by the Python package build (pypi/setup.py).
//
// lnumber/inc/laman_number.h includes <tr1/unordered_set>, which exists in
// libstdc++ but not in libc++ (macOS) or modern MSVC. This header is found
// first on the include path and maps the C++11 container onto the names that
// laman_number.h uses: std::tr1::unordered_set and, on Windows,
// boost::unordered_set (the VS2008 branch uses "using namespace boost").
#pragma once

#include <unordered_set>

namespace std { namespace tr1 { using std::unordered_set; } }
namespace boost { using std::unordered_set; }
